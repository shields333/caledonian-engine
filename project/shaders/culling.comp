#version 460

#extension GL_GOOGLE_include_directive : require
#include "draw_structures.glsl"

layout (local_size_x = 32) in;

struct InstanceData{
    uint transformID;
    uint surfaceID;
};
layout(buffer_reference, std430) readonly buffer InstanceBuffer{
	InstanceData data[];
};

layout(buffer_reference, std430) readonly buffer TransformBuffer{
	mat4 data[];
};

struct SurfaceData{
    vec3 origin;
    uint indexCount;
    vec3 extents;
    uint firstIndex;
    uint matID;
    uint alphaMode;
};
layout(buffer_reference, std430) readonly buffer SurfaceBuffer{
	SurfaceData data[];
};

struct VkDrawIndexedIndirectCommand {
    uint    indexCount;
    uint    instanceCount;
    uint   firstIndex;
    int     vertexOffset;
    uint    firstInstance;
};
layout(buffer_reference, std430) buffer VisibleDrawBuffer{
    uint count;
    VkDrawIndexedIndirectCommand data[];
};

//push constants block
layout( push_constant ) uniform Constants
{
    mat4 viewproj;
    uint objCount;
    InstanceBuffer inInstanceBuf;
    TransformBuffer inTransformBuf;
    SurfaceBuffer inSurfaceBuf;
    VisibleObjectBuffer outOpaqueObjBuf;
    VisibleObjectBuffer outCutoutObjBuf;
    VisibleObjectBuffer outTransparentObjBuf;
    VisibleDrawBuffer outOpaqueDrawBuf;
    VisibleDrawBuffer outCutoutDrawBuf;
    VisibleDrawBuffer outTransparentDrawBuf;
} pushConstants;

bool frustumCull(SurfaceData surface, mat4 modelMatrix) {
   vec3 corners[8] = {
        vec3 ( 1.0, 1.0, 1.0 ),
        vec3 ( 1.0, 1.0, -1.0 ),
        vec3 ( 1.0, -1.0, 1.0 ),
        vec3 ( 1.0, -1.0, -1.0 ),
        vec3 ( -1.0, 1.0, 1.0 ),
        vec3 ( -1.0, 1.0, -1.0 ),
        vec3 ( -1.0, -1.0, 1.0 ),
        vec3 ( -1.0, -1.0, -1.0 ),
    };

    mat4 matrix = pushConstants.viewproj * modelMatrix;

    vec3 minimum = vec3(1.5, 1.5, 1.5);
    vec3 maximum = vec3(-1.5, -1.5, -1.5);

    for (int c = 0; c < 8; c++) {
        // project each corner into clip space
        vec4 v = matrix * vec4(surface.origin + (corners[c] * surface.extents), 1.f);

        // perspective correction
        v.x = v.x / v.w;
        v.y = v.y / v.w;
        v.z = v.z / v.w;

        minimum = min(v.xyz, minimum);
        maximum = max(v.xyz, maximum);
    }

    // check the clip space box is within the view
    if (minimum.z > 1.f || maximum.z < 0.f || minimum.x > 1.f || maximum.x < -1.f || minimum.y > 1.f || maximum.y < -1.f) {
        return false;
    }
    else {
        return true;
    }
}

void main() 
{
    if (gl_GlobalInvocationID.x >= pushConstants.objCount)
        return;

    InstanceData instance = pushConstants.inInstanceBuf.data[gl_GlobalInvocationID.x];

    SurfaceData surface = pushConstants.inSurfaceBuf.data[instance.surfaceID];
    mat4 modelMatrix = pushConstants.inTransformBuf.data[instance.transformID];

    if(frustumCull(surface, modelMatrix)){    
        if (surface.alphaMode == 0){
            uint count = atomicAdd(pushConstants.outOpaqueDrawBuf.count, 1);

            VkDrawIndexedIndirectCommand drawCmd;
            drawCmd.indexCount = surface.indexCount;
            drawCmd.firstIndex = surface.firstIndex;
            drawCmd.firstInstance = count;
            drawCmd.instanceCount = 1;
            drawCmd.vertexOffset = 0;

            ObjectData objData;
            objData.modelMatrix = modelMatrix;
            objData.matID = surface.matID;
            
            pushConstants.outOpaqueObjBuf.data[count] = objData;
            pushConstants.outOpaqueDrawBuf.data[count] = drawCmd;
        } 
        else if (surface.alphaMode == 2) {
            uint count = atomicAdd(pushConstants.outCutoutDrawBuf.count, 1);

            VkDrawIndexedIndirectCommand drawCmd;
            drawCmd.indexCount = surface.indexCount;
            drawCmd.firstIndex = surface.firstIndex;
            drawCmd.firstInstance = count;
            drawCmd.instanceCount = 1;
            drawCmd.vertexOffset = 0;

            ObjectData objData;
            objData.modelMatrix = modelMatrix;
            objData.matID = surface.matID;
            
            pushConstants.outCutoutObjBuf.data[count] = objData;
            pushConstants.outCutoutDrawBuf.data[count] = drawCmd;
        } 
        else {
            uint count = atomicAdd(pushConstants.outTransparentDrawBuf.count, 1);

            VkDrawIndexedIndirectCommand drawCmd;
            drawCmd.indexCount = surface.indexCount;
            drawCmd.firstIndex = surface.firstIndex;
            drawCmd.firstInstance = count;
            drawCmd.instanceCount = 1;
            drawCmd.vertexOffset = 0;

            ObjectData objData;
            objData.modelMatrix = modelMatrix;
            objData.matID = surface.matID;
            
            pushConstants.outTransparentObjBuf.data[count] = objData;
            pushConstants.outTransparentDrawBuf.data[count] = drawCmd;
        }
    }
}

